{
  "name": "lol-level-calculator",
  "version": "1.0.0",
  "description": "LoL Companion : appli de bureau qui lit le client League of Legends (sans clé API) pour suivre ton niveau, ta progression et plus encore.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder"
  },
  "keywords": [
    "league-of-legends",
    "electron",
    "calculator"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lolcalculator.app",
    "productName": "LoL Companion",
    "files": [
      "main.js",
      "preload.js",
      "lcu.js",
      "stockage.js",
      "surveillance.js",
      "progression.js",
      "classee.js",
      "missions.js",
      "acceptation.js",
      "parties.js",
      "maitrise.js",
      "session.js",
      "arriere-plan.js",
      "selection.js",
      "runes.js",
      "build.js",
      "opgg.js",
      "lolalytics.js",
      "draft.js",
      "objectifs.js",
      "sorts.js",
      "augments.js",
      "ocr.js",
      "arammayhem.js",
      "sondage.js",
      "journal.js",
      "preload-overlay.js",
      "assets/**/*",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}

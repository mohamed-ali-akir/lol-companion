{
  "name": "lol-level-calculator",
  "version": "1.5.0",
  "description": "LoL Companion : appli de bureau qui lit le client League of Legends (sans clé API) pour suivre ton niveau, ta progression et plus encore.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder",
    "sonde": "node outils/sonde.js",
    "essai": "electron outils/essai-complet.js",
    "build:local": "node outils/build-local.js"
  },
  "keywords": [
    "league-of-legends",
    "electron",
    "calculator"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lolcalculator.app",
    "productName": "LoL Companion",
    "files": [
      "main.js",
      "preload.js",
      "lcu.js",
      "stockage.js",
      "surveillance.js",
      "progression.js",
      "champions.js",
      "acceptation.js",
      "parties.js",
      "sauvegarde-sets.js",
      "maitrise.js",
      "arriere-plan.js",
      "selection.js",
      "challenge.js",
      "runes.js",
      "build.js",
      "stats-build.js",
      "internet.js",
      "opgg.js",
      "lolalytics.js",
      "familles.js",
      "draft.js",
      "jeu.js",
      "donnees-jeu.js",
      "sorts.js",
      "pings.js",
      "image.js",
      "adversaires.js",
      "augments.js",
      "ocr.js",
      "arammayhem.js",
      "sondage.js",
      "fichiers.js",
      "migrations.js",
      "journal.js",
      "mise-a-jour.js",
      "maj-appli.js",
      "messages.js",
      "en-jeu.js",
      "preload-overlay.js",
      "assets/**/*",
      "src/**/*",
      "statistiques.js",
      "deadlock.js",
      "deadlock-api.js",
      "deadlock-donnees.js",
      "deadlock-jeu.js",
      "deadlock-stats.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "LoL-Companion-${version}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mohamed-ali-akir",
        "repo": "lol-companion",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "^8.22.0"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0"
  }
}
